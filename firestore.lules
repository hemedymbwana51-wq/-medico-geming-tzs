rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mtumiaji aliyesajiliwa (si mgeni)
    function isUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Admin pekee (UID kutoka firebase-config.js)
    function isAdmin() {
      return isUser() && request.auth.uid == 'Jzoq0TmlmGPo803SGqBhNmXvLi52';
    }

    // Magemu
    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Admin anaweza kubadilisha gemu lolote.
      // Mtu yeyote anaweza tu kuongeza hesabu ya downloads au maoni, bila kugusa sehemu nyingine.
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'commentCount'])
      );
    }

    // Maoni
    match /comments/{cid} {
      allow read: if true;
      allow create: if isUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin() || (isUser() && resource.data.uid == request.auth.uid);
    }

    // Maombi ya malipo
    match /paymentRequests/{reqId} {
      allow create: if isUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.images.size() <= 2;
      allow read: if isAdmin() || (isUser() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Malipo yaliyothibitishwa: mteja anasoma yake mwenyewe (resource == null ina maana hakuna malipo bado)
    match /entitlements/{entId} {
      allow read: if isUser() && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Profile za watumiaji
    match /users/{uid} {
      allow read: if isAdmin() || (isUser() && request.auth.uid == uid);
      allow create, update: if isUser() && request.auth.uid == uid;
    }

    // Mazungumzo: thread ya kila mtumiaji
    match /chats/{uid} {
      allow read, write: if isAdmin() || (isUser() && request.auth.uid == uid);
    }

    // Ujumbe ndani ya mazungumzo
    match /chats/{uid}/messages/{msgId} {
      allow read: if isAdmin() || (isUser() && request.auth.uid == uid);
      allow create: if (isUser() && request.auth.uid == uid
                        && request.resource.data.from == 'user'
                        && request.resource.data.uid == uid)
                    || (isAdmin() && request.resource.data.from == 'admin');
    }
  }
}

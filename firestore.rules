rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mtumiaji aliyesajiliwa (si mgeni)
    function isUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Admin pekee (UID kutoka firebase-config.js)
    function isAdmin() {
      return isUser() && request.auth.uid == 'Jzoq0TmlmGPo803SGqBhNmXvLi52';
    }

    // Thamani ya zamani ya sehemu ya wallet (0 kama haipo bado)
    function prevW(f) {
      return (f in resource.data) ? resource.data[f] : 0;
    }

    // Tofauti ya sehemu ya wallet kabla na baada ya mabadiliko
    function wdiff(f) {
      return request.resource.data[f] - prevW(f);
    }

    // Muuzaji aliyeidhinishwa (ana ada ya duka iliyothibitishwa)
    function isSeller() {
      return isUser() && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
             && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.active == true;
    }

    // Magemu na movie
    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Admin anaweza kubadilisha chochote. Mtu yeyote anaweza tu kuongeza
      // views, downloads, au commentCount, bila kugusa sehemu nyingine.
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'commentCount', 'views'])
      );

      // Watazamaji na waliopakua: kila mtumiaji anaandika yake tu
      match /viewers/{uid} {
        allow read: if true;
        allow create, update: if isUser() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // Maoni
    match /comments/{cid} {
      allow read: if true;
      allow create: if isUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin() || (isUser() && resource.data.uid == request.auth.uid);
    }

    // Jumuiya (chat ya kikundi)
    match /groupMessages/{mid} {
      allow read: if isUser() || isAdmin();
      allow create: if (isUser() && request.resource.data.uid == request.auth.uid
                        && request.resource.data.from == 'user'
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 500)
                    || (isAdmin() && request.resource.data.from == 'admin');
      allow delete: if isAdmin();
    }

    // Maombi ya malipo (gemu na ada ya duka)
    match /paymentRequests/{reqId} {
      allow create: if isUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.images.size() <= 2;
      allow read: if isAdmin() || (isUser() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Malipo ya gemu yaliyothibitishwa
    match /entitlements/{entId} {
      allow read: if isUser() && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Wauzaji waliothibitishwa
    match /sellers/{uid} {
      allow read: if isAdmin() || (isUser() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Bidhaa za duka
    match /products/{pid} {
      allow read: if true;
      allow create: if isSeller()
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.images.size() <= 2;
      allow update, delete: if isAdmin() || (isUser() && resource.data.sellerUid == request.auth.uid);
    }

    // Profile na token za watumiaji
    // Token kwa kila mabadiliko: upeo wa 50 kwa mara moja (zawadi ya siku 7)
    match /users/{uid} {
      allow read: if isAdmin() || (isUser() && request.auth.uid == uid);
      allow create: if isUser() && request.auth.uid == uid
                    && (!('tokens' in request.resource.data) || request.resource.data.tokens <= 50);
      allow update: if isUser() && request.auth.uid == uid
                    && (!('tokens' in request.resource.data)
                        || request.resource.data.tokens - (('tokens' in resource.data) ? resource.data.tokens : 0) <= 50);
    }

    // Balance ya admin (admin pekee anaiona). Kila tukio linaongeza TZS 1000:
    // mwonekano wa game (viewEarn), usajili (signupEarn), au kuingia kila siku (dailyEarn).
    match /wallet/admin {
      allow read: if isAdmin();
      allow create: if isUser()
                    && request.resource.data.balance == 1000
                    && (
                      (request.resource.data.viewEarn == 1000 && request.resource.data.signupEarn == 0 && request.resource.data.dailyEarn == 0) ||
                      (request.resource.data.viewEarn == 0 && request.resource.data.signupEarn == 1000 && request.resource.data.dailyEarn == 0) ||
                      (request.resource.data.viewEarn == 0 && request.resource.data.signupEarn == 0 && request.resource.data.dailyEarn == 1000)
                    );
      allow update: if isAdmin() || (isUser()
                    && wdiff('balance') == 1000
                    && (
                      (wdiff('viewEarn') == 1000 && wdiff('signupEarn') == 0 && wdiff('dailyEarn') == 0) ||
                      (wdiff('viewEarn') == 0 && wdiff('signupEarn') == 1000 && wdiff('dailyEarn') == 0) ||
                      (wdiff('viewEarn') == 0 && wdiff('signupEarn') == 0 && wdiff('dailyEarn') == 1000)
                    ));
    }

    // Taarifa kwa wateja (admin pekee anaandika)
    match /notifications/{nid} {
      allow read: if isUser() || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Mipangilio ya admin (mapato ya matangazo yanayoingizwa na admin)
    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    // Mazungumzo ya faragha na admin
    match /chats/{uid} {
      allow
